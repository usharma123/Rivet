RIVET_ENV=production
RIVET_STORE=postgres
DATABASE_URL=postgres://rivet:REPLACE_ME@127.0.0.1:5432/rivet?sslmode=disable
RIVET_ADDR=127.0.0.1:8080
RIVET_DATA_DIR=/var/lib/rivet
RIVET_ARTIFACT_DIR=/var/lib/rivet/artifacts
RIVET_SIGNING_KEY_FILE=/etc/rivet/signing.key
RIVET_REGISTRY_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
RIVET_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
RIVET_PUBLIC_MIRROR=false
RIVET_VERIFY_PROVENANCE=true
RIVET_AUDIT_MODE=gvisor
RIVET_AUDIT_AGENT_IMAGE=rivet-audit-agent:REPLACE_WITH_COMMIT
RIVET_AUDIT_OBSERVER_IMAGE=rivet-audit-observer:REPLACE_WITH_COMMIT
RIVET_AUDIT_RUNSC_BIN=/usr/local/bin/rivet-runsc-query
RIVET_AUDIT_RUNSC_ROOT=/var/run/docker/runtime-runc/moby
